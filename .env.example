# AI 버전 정보
AI_VERSION=v1.0.065

# 시작 시 ANSI Art 배너 출력 여부 (true/false). 기본값: true
PRINT_BANNER=true
# MAX CONTEXT 사이즈 
MAX_CONTEXT_SIZE=500000

# 플랫폼별 컨텍스트 윈도우의 75%를 안전 한도로 설정
MAX_TOKENS_CLAUDE=150000
MAX_TOKENS_GENAI=96000
MAX_TOKENS_GEMINI=786000

# 에이전트 최대 출력 토큰 수
AGENT_MAX_OUTPUT_TOKENS=8194
# 최대 유지할 메시지 수 (.env에서 설정 가능, 기본값 30)
MAX_MESSAGES_TO_KEEP=6

# GenAI API 로깅 (true: 켜기 / false: 끄기)
GEN_AI_LOG_ENABLED=false
# Gemini API 로깅 (true: 켜기 / false: 끄기)
GEMINI_AI_LOG_ENABLED=true
# Claude API 로깅 (true: 켜기 / false: 끄기)
CLAUDE_AI_LOG_ENABLED=true

# /auto_context 명령어 재시도 횟수
AUTO_CONTEXT_MAX_RETRIES=3

# === 자율 에이전트 (/agents) — FSD v1.0.083 ===
AGENT_MAX_ITERATIONS=10
AGENT_SELF_CORRECT_MAX=3
AGENT_COMPACT_AFTER=5
AGENT_CODE_TIMEOUT=30
AGENT_DONE_TOKEN=[AGENT_DONE]

# === 에이전트 세션 저장 (FSD v1.0.086) ===
AGENT_MAX_SAVED_SESSIONS=5
AGENT_AUTO_SAVE_INTERVAL=3

# gen-ai-chat-code.py
ENDPOINT_URL="https://scisportaldev.samsungif.net/rest/genAi"
YOUR_CLIENT_KEY="API_CLIENT_APP"
YOUR_CLIENT_SECRET=""
YOUR_MODEL_ID="gpt-oss-120B-medium"

# claude-ai-cat-code.py
CLAUDE_API_ENDPOINT="https://api.anthropic.com"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL_ID="claude-3-5-haiku-latest"

# gemini-ai-chat-code.py
GEMINI_API_KEY=""
GEMINI_MODEL_ID="gemini-3-pro-preview"
GEMINI_API_ENDPOINT="https://generativelanguage.googleapis.com/v1beta"

# === 기본 시스템 프롬프트 템플릿 (FSD v1.0.161) ===
# 값은 .system_prompts/<filename>.yaml 의 파일명 stem (확장자 제외).
# 미설정 시 어시스턴트 타입별 기본 파일명 (`<type>-system-prompt`) 을 사용한다.
DEFAULT_CLAUDE_TEMPLATE=claude-system-prompt
DEFAULT_GEMINI_TEMPLATE=gemini-system-prompt
DEFAULT_GENAI_TEMPLATE=genai-system-prompt
